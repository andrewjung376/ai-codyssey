# 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# 응답 토큰 상한 (과금 방지)
OPENAI_MAX_TOKENS=600

# Firebase 서비스 계정 키: JSON 문자열 한 줄 또는 키 파일 경로
#   로컬: 파일 경로가 편함   예) C:/keys/my-project-firebase-adminsdk.json
#   Render: JSON 내용 전체를 한 줄로 붙여넣기
FIREBASE_SERVICE_ACCOUNT_JSON=

# firestore(기본) | memory (Firebase 키 없이 로컬에서 시드 데이터로 실행)
STORAGE_BACKEND=firestore

# CORS 허용 도메인 (쉼표 구분). 배포 시 Vercel 주소를 추가
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
